---
// Break long dotted package ids after each dot instead of mid-word.
const title: string = Astro.locals.starlightRoute.entry.data.title;
const html = title.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\./g, '.<wbr>');
---

<h1 id="_top" data-page-title set:html={html} />

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
