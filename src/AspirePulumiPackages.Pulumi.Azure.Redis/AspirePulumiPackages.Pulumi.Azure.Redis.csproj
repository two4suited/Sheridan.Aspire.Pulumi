<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AspirePulumiPackages.Pulumi.Azure.Redis</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <!-- RunAsContainer reuses the stock Redis container resource. -->
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspirePulumiPackages.Pulumi\AspirePulumiPackages.Pulumi.csproj" />
    <ProjectReference Include="..\AspirePulumiPackages.Pulumi.Azure.Base\AspirePulumiPackages.Pulumi.Azure.Base.csproj" />
    <ProjectReference Include="..\AspirePulumiPackages.Pulumi.Azure.KeyVault\AspirePulumiPackages.Pulumi.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\AspirePulumiPackages.Pulumi.Provisioning\AspirePulumiPackages.Pulumi.Provisioning.csproj" />
    <!-- Only for IPulumiManagedIdentityResource (compute environments' shared identity); the root project is not extended. -->
    <ProjectReference Include="..\AspirePulumiPackages.Pulumi.Azure\AspirePulumiPackages.Pulumi.Azure.csproj" />
  </ItemGroup>

</Project>
