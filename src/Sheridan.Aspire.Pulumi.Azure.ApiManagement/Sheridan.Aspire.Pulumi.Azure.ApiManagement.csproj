<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure API Management provisioned by Pulumi instead of Bicep, a drop-in for AddAzureApiManagement in Aspire.Hosting.Azure.ApiManagement. Call AddPulumiAzureApiManagement(name, new AzureApiManagementOptions { PublisherEmail, PublisherName, Sku }) to provision the service with a system-assigned identity (outputs gatewayUrl, name, id, principalId), then model APIs (AddApi, AddOperation), backends (AddBackend, WithBackend), products (AddProduct, WithApi), named values (AddNamedValue) and policies (WithInboundPolicy, WithPolicy). Requires Sheridan.Aspire.Pulumi (AddPulumiStack). Full usage and the list of not-yet-ported features: https://github.com/two4suited/Sheridan.Aspire.Pulumi/tree/main/src/Sheridan.Aspire.Pulumi.Azure.ApiManagement#readme</Description>
    <RootNamespace>Sheridan.Aspire.Pulumi.Azure.ApiManagement</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sheridan.Aspire.Pulumi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi\Sheridan.Aspire.Pulumi.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Base\Sheridan.Aspire.Pulumi.Azure.Base.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Provisioning\Sheridan.Aspire.Pulumi.Provisioning.csproj" />
    <!-- Only for IPulumiManagedIdentityResource (the compute environment identity that receives data-plane roles). -->
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure\Sheridan.Aspire.Pulumi.Azure.csproj" />
  </ItemGroup>

</Project>
