<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure Functions projects for Aspire, deployed to a Pulumi-provisioned compute environment. Part of Sheridan.Aspire.Pulumi, which provisions Aspire resources with Pulumi instead of Bicep. Usage and docs: https://github.com/two4suited/Sheridan.Aspire.Pulumi/tree/main/src/Sheridan.Aspire.Pulumi.Azure.Functions#readme</Description>
    <RootNamespace>Sheridan.Aspire.Pulumi.Azure.Functions</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004;ASPIRECOMMAND001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <!-- Only for AzureFunctionsAnnotation, the marker Aspire uses to recognise a project as an Azure Functions app. -->
    <PackageReference Include="Aspire.Hosting.Azure" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi\Sheridan.Aspire.Pulumi.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Base\Sheridan.Aspire.Pulumi.Azure.Base.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Storage\Sheridan.Aspire.Pulumi.Azure.Storage.csproj" />
    <!-- The compute environment (Container Apps today) hosting the function app: IPulumiManagedIdentityResource and container app customization. -->
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure\Sheridan.Aspire.Pulumi.Azure.csproj" />
  </ItemGroup>

</Project>
