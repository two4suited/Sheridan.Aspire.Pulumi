<Project>

  <!--
    Every project under src/ is published as a NuGet package whose PackageId equals the project
    name, e.g. Sheridan.Aspire.Pulumi.Azure.KeyVault. ProjectReferences become package
    dependencies automatically.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Brian Sheridan</Authors>
    <Description>Aspire hosting integration that provisions Azure infrastructure with Pulumi instead of Bicep/ARM.</Description>
    <PackageTags>aspire;pulumi;azure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/two4suited/aspire.pulumi.packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Each package ships its own README.md when it has one, otherwise the repository README. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
