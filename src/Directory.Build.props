<Project>

  <!--
    Every AspirePulumiPackages.Pulumi* project under src/ is published as a NuGet package named
    Sheridan.Pulumi<suffix>, e.g. AspirePulumiPackages.Pulumi.Azure.KeyVault -> Sheridan.Pulumi.Azure.KeyVault.
    The Api and AppHost projects are not packages.
    ProjectReferences become package dependencies using the renamed PackageId automatically.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('AspirePulumiPackages.Pulumi'))">
    <IsPackable>true</IsPackable>
    <PackageId>Sheridan.Pulumi$(MSBuildProjectName.Substring(27))</PackageId>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Authors>Brian Sheridan</Authors>
    <Description>Aspire hosting integration that provisions Azure infrastructure with Pulumi instead of Bicep/ARM.</Description>
    <PackageTags>aspire;pulumi;azure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/two4suited/aspire.pulumi.packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('AspirePulumiPackages.Pulumi'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
