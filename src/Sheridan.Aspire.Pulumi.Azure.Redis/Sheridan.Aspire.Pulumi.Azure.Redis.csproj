<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure Cache for Redis and Azure Managed Redis provisioned by Pulumi, drop-ins for AddAzureRedis and AddAzureManagedRedis.</Description>
    <RootNamespace>Sheridan.Aspire.Pulumi.Azure.Redis</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <!-- RunAsContainer reuses the stock Redis container resource. -->
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi\Sheridan.Aspire.Pulumi.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Base\Sheridan.Aspire.Pulumi.Azure.Base.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.KeyVault\Sheridan.Aspire.Pulumi.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Provisioning\Sheridan.Aspire.Pulumi.Provisioning.csproj" />
    <!-- Only for IPulumiManagedIdentityResource (compute environments' shared identity); the root project is not extended. -->
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure\Sheridan.Aspire.Pulumi.Azure.csproj" />
  </ItemGroup>

</Project>
