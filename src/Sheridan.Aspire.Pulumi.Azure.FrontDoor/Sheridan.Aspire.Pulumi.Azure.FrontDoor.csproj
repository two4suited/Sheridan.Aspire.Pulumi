<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure Front Door in front of your Container Apps or App Service apps, provisioned by Pulumi. Part of Sheridan.Aspire.Pulumi, which provisions Aspire resources with Pulumi instead of Bicep. Usage and docs: https://github.com/two4suited/Sheridan.Aspire.Pulumi/tree/main/src/Sheridan.Aspire.Pulumi.Azure.FrontDoor#readme</Description>
    <RootNamespace>Sheridan.Aspire.Pulumi.Azure.FrontDoor</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES004;ASPIREPROBES001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi\Sheridan.Aspire.Pulumi.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Provisioning\Sheridan.Aspire.Pulumi.Provisioning.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Base\Sheridan.Aspire.Pulumi.Azure.Base.csproj" />
    <!-- The origin host is read from the container app / web app the compute environment emits. -->
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.AppContainers\Sheridan.Aspire.Pulumi.Azure.AppContainers.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.AppService\Sheridan.Aspire.Pulumi.Azure.AppService.csproj" />
  </ItemGroup>

</Project>
