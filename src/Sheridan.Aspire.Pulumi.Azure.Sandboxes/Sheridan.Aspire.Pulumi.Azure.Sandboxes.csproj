<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Azure Container Apps Sandboxes as an Aspire compute environment, provisioned by Pulumi plus a data-plane deployment step.</Description>
    <RootNamespace>Sheridan.Aspire.Pulumi.Azure.Sandboxes</RootNamespace>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREPIPELINES003;ASPIREPIPELINES004;ASPIRECONTAINERRUNTIME001;ASPIREPROJECTS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <!-- Credential for the sandbox data plane (not an ARM API), as the official Aspire.Hosting.Azure.Sandboxes uses. -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi\Sheridan.Aspire.Pulumi.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Provisioning\Sheridan.Aspire.Pulumi.Provisioning.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.Base\Sheridan.Aspire.Pulumi.Azure.Base.csproj" />
    <ProjectReference Include="..\Sheridan.Aspire.Pulumi.Azure.ContainerRegistry\Sheridan.Aspire.Pulumi.Azure.ContainerRegistry.csproj" />
  </ItemGroup>

</Project>
